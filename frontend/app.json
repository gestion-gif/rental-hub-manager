{
  "expo": {
    "name": "Casanéo Terrain",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.emergent.rentalhubmanager.p4jvi7",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ajouter des photos de l'état des lieux",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#020830"
      },
      "package": "com.casaneo.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020830"
        }
      ],
      "expo-build-properties",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/ant-design",
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
